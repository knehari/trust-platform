FROM rust:1.99.0-bookworm AS build
WORKDIR /app
COPY . .
RUN cargo build -p trust-management-api --release --locked

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/target/release/trust-management-api /usr/local/bin/trust-management-api
USER nobody
ENTRYPOINT ["trust-management-api"]

